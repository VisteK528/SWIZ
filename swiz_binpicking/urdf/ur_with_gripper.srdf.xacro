<?xml version="1.0" encoding="UTF-8"?>
<!--
  SRDF for UR5e + Robotiq 2F-85 (prefix="gripper_").
  Extends the stock ur_moveit_config SRDF macro with the gripper group
  and all required disabled-collision pairs for the gripper links.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur">

  <!-- Reuse the standard UR group definitions and UR disabled-collision pairs -->
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf/>

  <!-- ── Gripper planning group ─────────────────────────────────────────── -->
  <!-- Only the actuated knuckle joint; mimic joints follow automatically.  -->
  <group name="gripper">
    <joint name="gripper_robotiq_85_left_knuckle_joint"/>
  </group>

  <group_state name="open"   group="gripper">
    <joint name="gripper_robotiq_85_left_knuckle_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_robotiq_85_left_knuckle_joint" value="0.8"/>
  </group_state>

  <!-- ── Disabled collisions: gripper ↔ UR wrist ───────────────────────── -->
  <disable_collisions link1="gripper_robotiq_85_base_link" link2="wrist_3_link"                    reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_85_base_link" link2="wrist_2_link"                    reason="Never"/>
  <disable_collisions link1="gripper_robotiq_85_base_link" link2="tool0"                           reason="Adjacent"/>

  <!-- ── Disabled collisions: within gripper ───────────────────────────── -->
  <disable_collisions link1="gripper_robotiq_85_base_link"          link2="gripper_robotiq_85_left_knuckle_link"       reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_85_base_link"          link2="gripper_robotiq_85_right_knuckle_link"      reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_85_base_link"          link2="gripper_robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_85_base_link"          link2="gripper_robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>

  <disable_collisions link1="gripper_robotiq_85_left_knuckle_link"  link2="gripper_robotiq_85_left_finger_link"        reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_85_right_knuckle_link" link2="gripper_robotiq_85_right_finger_link"       reason="Adjacent"/>

  <disable_collisions link1="gripper_robotiq_85_left_finger_link"   link2="gripper_robotiq_85_left_finger_tip_link"    reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_85_right_finger_link"  link2="gripper_robotiq_85_right_finger_tip_link"   reason="Adjacent"/>

  <disable_collisions link1="gripper_robotiq_85_left_inner_knuckle_link"  link2="gripper_robotiq_85_left_finger_tip_link"   reason="Adjacent"/>
  <disable_collisions link1="gripper_robotiq_85_right_inner_knuckle_link" link2="gripper_robotiq_85_right_finger_tip_link"  reason="Adjacent"/>

  <!-- Symmetric pairs that are never in collision with each other -->
  <disable_collisions link1="gripper_robotiq_85_left_knuckle_link"       link2="gripper_robotiq_85_right_knuckle_link"      reason="Never"/>
  <disable_collisions link1="gripper_robotiq_85_left_finger_link"         link2="gripper_robotiq_85_right_finger_link"       reason="Never"/>
  <disable_collisions link1="gripper_robotiq_85_left_inner_knuckle_link"  link2="gripper_robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="gripper_robotiq_85_left_finger_tip_link"     link2="gripper_robotiq_85_right_finger_tip_link"   reason="Never"/>

  <!-- Finger tips vs base – geometrically always clear at valid joint limits -->
  <disable_collisions link1="gripper_robotiq_85_left_finger_tip_link"  link2="gripper_robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="gripper_robotiq_85_right_finger_tip_link" link2="gripper_robotiq_85_base_link" reason="Never"/>

  <!-- Knuckles vs inner knuckles on same side -->
  <disable_collisions link1="gripper_robotiq_85_left_knuckle_link"  link2="gripper_robotiq_85_left_inner_knuckle_link"  reason="Never"/>
  <disable_collisions link1="gripper_robotiq_85_right_knuckle_link" link2="gripper_robotiq_85_right_inner_knuckle_link" reason="Never"/>

</robot>
