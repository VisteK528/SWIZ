<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <physics name="ode_tuned" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>world</type>                          
          <iters>200</iters>                         
          <sor>1.3</sor>                              
        </solver>
        <constraints>
          <cfm>1e-6</cfm>                             
          <erp>0.2</erp>                              
        </constraints>
      </ode>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>


    <include>
    <uri>
    https://fuel.gazebosim.org/1.0/Open-RMF/models/conveyor_block
    </uri>
    <pose>0 0.6 0 0 0.0 1.570796327</pose>
    <name>first_conveyor</name>
    </include>

    <include>
    <uri>
    https://fuel.gazebosim.org/1.0/Open-RMF/models/conveyor_block
    </uri>
    <pose>0.6 0.0 0 0 0.0 0.0</pose>
    <name>second_conveyor</name>
    </include>

   <include>
      <pose>0 0.6 0.6 0 0.0 1.570796327</pose>
      <uri>checkerboard.sdf</uri>
    </include>

    <model name='box'>
      <pose>8.0 0 2.5 9.3851161270657419e-17
        -5.6069031016222445e-17 -3.9093360295039407e-19</pose>
      <link name='box_link'>
        <inertial>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
          </inertia>
          <mass>1</mass>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name='box_collision'>
          <geometry>
            <box>
              <size>1.0 5.0 5.0</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode />
            </friction>
            <bounce />
            <contact />
          </surface>
        </collision>
        <visual name='box_visual'>
          <geometry>
            <box>
              <size>1.0 5.0 5.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.300000012 0.300000012 0.300000012 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>false</static>
      <self_collide>false</self_collide>
    </model>

    <model name="left_camera">
      <static>true</static>
      <pose>0.05 0.6 1.0 0 0.0 0.0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </visual>
        <sensor name="camera" type="wideanglecamera">
          <pose>0 0 0 0 1.570796327 0</pose>
          <topic>left_camera</topic>
          <visualize>true</visualize>
          <update_rate>30</update_rate>
          <always_on>true</always_on>

          <camera>
            <horizontal_fov>1.9</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>

            <lens>
              <type>equidistant</type>
              <scale_to_hfov>true</scale_to_hfov>
              <cutoff_angle>1.5707</cutoff_angle>
              <env_texture_size>2048</env_texture_size>
            </lens>

            <!-- <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise> -->
          </camera>
        </sensor>
      </link>
    </model>

    <model name="right_camera">
      <static>true</static>
      <pose>-0.05 0.6 1.0 0 0.0 0.0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </visual>
        <sensor name="camera" type="wideanglecamera">
          <pose>0 0 0 0 1.570796327 0</pose>
          <topic>right_camera</topic>
          <visualize>true</visualize>
          <update_rate>30</update_rate>
          <always_on>true</always_on>

          <camera>
            <horizontal_fov>1.9</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>

            <lens>
              <type>equidistant</type>
              <scale_to_hfov>true</scale_to_hfov>
              <cutoff_angle>1.5707</cutoff_angle>
              <env_texture_size>2048</env_texture_size>
            </lens>

            <!-- <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.005</stddev>
            </noise> -->
          </camera>
        </sensor>
      </link>
    </model>


  </world>
</sdf>